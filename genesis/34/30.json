    {
      "kind": "idiom",
      "subject": "is",
      "rationale": "מתי מספר er fastyrðing: 'fáir tals, taldir á fingur'."
    },
    {
      "kind": "substitution",
      "subject": "is",
      "rationale": "להבאישני er bókstaflega 'að gera mig að lykt' — 'að gera mig óþolanlega í augum' varðar merkinguna en tapar lyktarmyndlínina."
    }
