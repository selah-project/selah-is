    {
      "kind": "crux",
      "subject": "בשל אשר",
      "rationale": "Tvilýnt: 'því hversu sem' (hversu meira sem hann leitar, því minna finnur hann) eða einfaldlega orsakað 'því, í því skyni að'."
    },
    {
      "kind": "addition",
      "subject": "það",
      "rationale": "Íslenskan þarf andlag við 'finna' í seinna huhnni; hebreskan sleppir því."
    }
