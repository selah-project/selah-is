    {
      "kind": "crux",
      "subject": "מלקטים",
      "rationale": "'Söfnuðu upp' (aur) — sumir þýða 'söfnuðu matarleifa', aðrir 'Kröpu saman undir'; orðið er sama og um kornaupu."
    }
